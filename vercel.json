{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "server/blog.db",
        "node_modules/sqlite3/build/Release/node_sqlite3.node"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
